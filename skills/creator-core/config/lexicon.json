  "tells": [
    {
      "id": "not_just_but",
      "pattern": "\\bnot (?:just|only|merely) [^.;!?\\n]{1,50}?[,;]?\\s*(?:but|it'?s|it is|they'?re)\\b",
      "message": "\"Not just X, but Y\" framing. Say Y."
    },
    {
      "id": "its_not_its",
      "pattern": "\\b(?:it'?s|this is|that'?s) not (?:about )?[^.;!?\\n]{1,40}?[.,;\\u2014-]\\s*(?:it'?s|this is|that'?s)\\b",
      "message": "\"It's not X. It's Y.\" Correcting a claim nobody made."
    },
    {
      "id": "heres_the_thing",
      "pattern": "\\bhere'?s the (?:thing|kicker|truth|catch|twist|deal)\\b",
      "message": "Announces a point instead of making it."
    },
    {
      "id": "colon_reveal",
      "pattern": "\\bthe (?:result|answer|secret|catch|truth|best part|kicker|twist)\\?",
      "message": "Self-answered rhetorical question."
    },
    {
      "id": "lets_be_honest",
      "pattern": "\\blet'?s be (?:honest|real|clear)\\b",
      "message": "Throat-clearing before the point."
    },
    {
      "id": "imagine",
      "pattern": "^\\s*imagine (?:a world|if you could|this)\\b",
      "message": "Ad-copy opener."
    },
    {
      "id": "in_summary",
      "pattern": "\\b(?:in summary|to sum up|in conclusion|overall,)\\b",
      "message": "Essay closer. Captions do not need a summary."
    },
    {
      "id": "whether_youre",
      "pattern": "\\bwhether you'?re (?:a|an|just)\\b",
      "message": "Audience-hedging. Pick one person."
    },
    {
      "id": "ready_to",
      "pattern": "\\bready to (?:take|transform|elevate|level up|unlock)\\b",
      "message": "Template call to action."
    }
  ],
  "cta_patterns": {
    "_note": "Compiled case-sensitively; (?i:...) marks the case-insensitive parts. A comment ask needs an UPPERCASE keyword, a quoted word, or 'below'.",
    "comment": "(?i:\\b(?:comment|drop|type|reply with)\\b)[^.!?\\n]{0,40}?(?:\\b[A-Z]{2,}\\b|\"[^\"]+\"|(?i:\\bbelow\\b))",
    "save": "(?i:\\bsave (?:this|it|the post|for later)\\b)",
    "share": "(?i:\\b(?:share this|send this|send it to|tag (?:a|someone|the friend))\\b)",
    "follow": "(?i:\\bfollow (?:for|me|along)\\b)|(?i:\\bfollow) @",
    "dm": "(?i:\\b(?:dm me|message me|send me a (?:dm|message))\\b)|(?i:\\bdm)\\s+(?:(?i:the word)\\s+)?(?:[A-Z]{2,}\\b|\"[^\"]+\")",
    "link": "(?i:\\b(?:link in (?:my )?bio|tap the link|click the link|link below)\\b)",
    "book": "(?i:\\b(?:book a|apply (?:now|here|at)|sign up|join the waitlist|grab (?:the|your)|get (?:the|your|my) free|download (?:the|it))\\b)"
  }
